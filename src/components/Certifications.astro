---
import { siteConfig } from "../config";
const hasCertifications =
  siteConfig.certifications && siteConfig.certifications.length > 0;
---

{
  hasCertifications && (
    <section id="certifications" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-2xl sm:text-3xl md:text-4xl xl:text-6xl font-bold text-gray-900">
              Certifications
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {siteConfig.certifications.map((cert) => (
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 md:p-6 hover:shadow-md transition-shadow duration-300">
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 min-w-0">
                    {cert.link ? (
                      <a
                        href={cert.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs sm:text-sm font-semibold text-gray-900 hover:underline min-w-0"
                        style={`color: ${siteConfig.accentColor}`}
                      >
                        {cert.name}
                      </a>
                    ) : (
                      <h3 class="text-xs sm:text-sm font-semibold text-gray-900 min-w-0">
                        {cert.name}
                      </h3>
                    )}
                    {cert.issuer && cert.issuer !== "—" && (
                      <span class="text-xs text-gray-500 mt-1 sm:mt-0 shrink-0">
                        {cert.issuer}
                      </span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
